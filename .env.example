# Clerk Authentication — REQUIRED for /api/me/library sync (signed-out users get 503)
CLERK_SECRET_KEY=your_clerk_secret_key_here
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Durable storage — OPTIONAL. When set, per-member library docs, shares,
# play events, and error reports live in Postgres instead of data/app.db
# (Render's free disk is ephemeral — set this before real use there).
#
# Supabase: use the SESSION-MODE pooler URL (port 5432). Direct
# db.<ref>.supabase.co is IPv6-only — Render cannot reach it. The 6543
# transaction-mode pooler rejects prepared statements — do not use it.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# WARNING: exactly ONE running server may hold DATABASE_URL — the backend
# keeps an authoritative in-memory view; a second live instance diverges.
#DATABASE_URL=

# Configuration
MUSIC_DIR=/path/to/your/music/directory
PORT=3001
VITE_APP_URL=https://your-deployed-app-url
NODE_ENV=development
