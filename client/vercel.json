{
  "buildCommand": "pnpm install && pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/search",
      "destination": "/api/search"
    },
    {
      "source": "/api/artist/:path*",
      "destination": "/api/artist/:path*"
    },
    {
      "source": "/api/album/:path*",
      "destination": "https://torsongs.onrender.com/api/album/:path*"
    },
    {
      "source": "/api/song/:path*",
      "destination": "https://torsongs.onrender.com/api/song/:path*"
    },
    {
      "source": "/api/stream/:path*",
      "destination": "https://torsongs.onrender.com/api/stream/:path*"
    },
    {
      "source": "/api/playlist/:path*",
      "destination": "https://torsongs.onrender.com/api/playlist/:path*"
    },
    {
      "source": "/api/download-song",
      "destination": "https://torsongs.onrender.com/api/download-song"
    },
    {
      "source": "/api/download-album",
      "destination": "https://torsongs.onrender.com/api/download-album"
    },
    {
      "source": "/api/download-progress/:path*",
      "destination": "https://torsongs.onrender.com/api/download-progress/:path*"
    },
    {
      "source": "/api/scan",
      "destination": "https://torsongs.onrender.com/api/scan"
    },
    {
      "source": "/api/composer-albums/:path*",
      "destination": "https://torsongs.onrender.com/api/composer-albums/:path*"
    },
    {
      "source": "/api/health",
      "destination": "https://torsongs.onrender.com/api/health"
    },
    {
      "source": "/api/jio/:path*",
      "destination": "https://torsongs.onrender.com/api/jio/:path*"
    },
    {
      "source": "/api/trending-youtube",
      "destination": "https://torsongs.onrender.com/api/trending-youtube"
    },
    {
      "source": "/discover/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/search",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/dmca",
      "destination": "/index.html"
    }
  ]
}
